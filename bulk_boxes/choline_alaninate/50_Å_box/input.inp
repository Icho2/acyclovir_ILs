tolerance 2.0
filetype pdb
output choline_alaninate_bulk_acyclovir.pdb

structure ../choline.pdb
  number 100
  inside box 0. 0. 0. 50. 50. 50.
end structure

structure ../alaninate.pdb
  number 100
  inside box 0. 0. 0. 50. 50. 50.
end structure

structure ../acyclovir.pdb
  number 50
  inside box 0. 0. 0. 50. 50. 50.
end structure
